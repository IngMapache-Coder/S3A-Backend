{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 execute db-sd3-d1 --local --file=./src/db/schema.sql",
    "db:migrate:remote": "wrangler d1 execute db-sd3-d1 --remote --file=./src/db/schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260929.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.143.1"
  },
  "dependencies": {
    "hono": "^4.13.11"
  }
}
