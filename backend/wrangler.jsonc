/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-26",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// ─────────────────────────────────────────────────────────────
	// VARIABLES DE ENTORNO
	// ⚠️ JWT_SECRET: en producción usa `npx wrangler secret put JWT_SECRET`
	//    y elimina esta entrada de vars (texto plano solo para desarrollo local)
	// ─────────────────────────────────────────────────────────────
	"vars": {
		"JWT_SECRET": "9gTBrQ13atPYaegprRXyxVpAOqoEMKQDRw2sFoS9kZVGWnyaj6_SYjykmh1UGdf9cMK_qkNjXZgMepjyC95jXg"
	},
	// ─────────────────────────────────────────────────────────────
	// CLOUDFLARE D1 — Base de datos SQLite en el Edge
	// Acceso en código: c.env.DB  (tipo D1Database)
	// ─────────────────────────────────────────────────────────────
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "db-sd3-d1",
			"database_id": "9e3e4b08-f317-42b8-b5c9-18f402b3905b"
		}
	],
	// ─────────────────────────────────────────────────────────────
	// CLOUDFLARE R2 — Object Storage para imágenes de firmas
	// Acceso en código: c.env.FIRMAS_BUCKET  (tipo R2Bucket)
	// ─────────────────────────────────────────────────────────────
	"r2_buckets": [
		{
			"binding": "FIRMAS_BUCKET",
			"bucket_name": "db-sd3-r2"
		}
	]
}